---
// Site header: wordmark + primary nav. On mobile it collapses into a
// hamburger menu powered by a small vanilla client-side script at the
// bottom of this file — a simple example of JS (no framework needed).
import { site, nav } from '../config';

interface Props {
  // Transparent white-text header over a hero image; turns solid on scroll.
  heroOverlay?: boolean;
}
const { heroOverlay = false } = Astro.props;

// Astro gives us the current URL so we can highlight the active page.
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class:list={['site-header', { 'site-header--overlay': heroOverlay }]}>
  <div class="container header-inner">
    <a href="/" class="wordmark" aria-label={`${site.name} — home`}>
      <span class="wordmark-mark" aria-hidden="true"></span>
      {site.name}
    </a>

    <nav aria-label="Primary">
      <!-- Hamburger button (visible on mobile only via CSS) -->
      <button
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="primary-menu"
      >
        <span class="visually-hidden">Menu</span>
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>

      <div id="primary-menu" class="nav-menu">
        <ul class="nav-list">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li class="nav-cta">
            <a href="/get-involved" class="btn btn--primary nav-donate">
              Donate <span class="nav-donate-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>

        <!-- Contact block — visible only in the full-screen mobile menu. -->
        <div class="nav-contact">
          <a class="nav-contact-email" href={`mailto:${site.email}`}>{site.email}</a>
          <a class="nav-contact-social" href={site.social.instagram}>Instagram ↗</a>
          <a class="nav-contact-social" href={site.social.linkedin}>LinkedIn ↗</a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }
  /* .is-scrolled is toggled by JS once the user scrolls down.
     Hairline + shadow via box-shadow so the header height stays exactly --header-h. */
  .site-header.is-scrolled {
    box-shadow: 0 1px 0 var(--color-line), var(--shadow-sm);
  }

  /* --- Overlay mode: transparent, white text over a hero, until scrolled --- */
  .site-header--overlay:not(.is-scrolled) {
    background: transparent;
    backdrop-filter: none;
    box-shadow: none;
  }
  .site-header--overlay:not(.is-scrolled) .wordmark { color: #fff; }
  .site-header--overlay:not(.is-scrolled) .nav-toggle { border-color: rgba(255, 255, 255, 0.5); }
  .site-header--overlay:not(.is-scrolled) .nav-toggle-bars,
  .site-header--overlay:not(.is-scrolled) .nav-toggle-bars::before,
  .site-header--overlay:not(.is-scrolled) .nav-toggle-bars::after { background: #fff; }

  /* Nav links are white only on desktop; on mobile they live in a white dropdown. */
  @media (min-width: 821px) {
    .site-header--overlay:not(.is-scrolled) .nav-link { color: rgba(255, 255, 255, 0.82); }
    .site-header--overlay:not(.is-scrolled) .nav-link:hover,
    .site-header--overlay:not(.is-scrolled) .nav-link.is-active { color: #fff; }
    .site-header--overlay:not(.is-scrolled) .nav-link.is-active::after { background: #fff; }
    .site-header--overlay:not(.is-scrolled) .nav-cta .btn--primary { background: var(--color-warm); }
    .site-header--overlay:not(.is-scrolled) .nav-cta .btn--primary:hover { background: var(--color-warm-hover); }
  }

  .header-inner {
    display: flex; align-items: center; justify-content: space-between;
    min-height: var(--header-h); gap: var(--space-md);
  }

  .wordmark {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-display); font-weight: 600;
    font-size: var(--step-1); text-decoration: none; color: var(--color-ink);
  }
  .wordmark-mark {
    width: 22px; height: 22px; border-radius: 7px;
    background: var(--color-warm);
    /* subtle geometric motif — a nod to identity without flags/stereotypes */
    box-shadow: inset 0 0 0 3px color-mix(in srgb, #fff 70%, transparent);
  }

  .nav-menu { display: flex; align-items: center; }
  .nav-contact { display: none; }   /* only shown in the mobile full-screen menu */

  .nav-list {
    list-style: none; padding: 0; display: flex; align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }
  .nav-link {
    text-decoration: none; color: var(--color-ink-soft);
    font-weight: 500; font-size: 0.9375rem; letter-spacing: -0.006em;
    padding: 0.4rem 0; position: relative;
    transition: color 0.15s ease;
  }
  .nav-link:hover { color: var(--color-ink); }
  .nav-link.is-active { color: var(--color-ink); }
  .nav-link.is-active::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: -2px;
    height: 2px; background: var(--color-accent); border-radius: 2px;
  }

  /* Diagonal arrow on the Donate button — nudges up-right on hover. */
  .nav-donate-arrow { display: inline-block; transition: transform 0.18s ease; }
  .nav-donate:hover .nav-donate-arrow { transform: translate(2px, -2px); }

  .nav-toggle { display: none; }

  /* --- Mobile: full-screen menu that slides up --- */
  @media (max-width: 820px) {
    /* Keep the logo + hamburger above the menu overlay so the X can close it. */
    .wordmark { position: relative; z-index: 2; }
    .nav-toggle {
      display: inline-flex; align-items: center; justify-content: center;
      position: relative; z-index: 3;
      width: 44px; height: 44px; background: transparent;
      border: 1px solid var(--color-line); border-radius: 10px; cursor: pointer;
    }
    .nav-toggle-bars,
    .nav-toggle-bars::before,
    .nav-toggle-bars::after {
      content: ""; display: block; width: 20px; height: 2px;
      background: var(--color-ink); border-radius: 2px;
      transition: transform 0.2s ease, opacity 0.2s ease, background-color 0.2s ease;
    }
    .nav-toggle-bars { position: relative; }
    .nav-toggle-bars::before { position: absolute; top: -6px; }
    .nav-toggle-bars::after { position: absolute; top: 6px; }
    .nav-toggle[aria-expanded='true'] .nav-toggle-bars { background: transparent; }
    .nav-toggle[aria-expanded='true'] .nav-toggle-bars::before { transform: translateY(6px) rotate(45deg); }
    .nav-toggle[aria-expanded='true'] .nav-toggle-bars::after { transform: translateY(-6px) rotate(-45deg); }

    /* The overlay: fixed, dark, slides up from the bottom. */
    .nav-menu {
      position: fixed; inset: 0; z-index: 1;
      background: var(--color-bg);
      flex-direction: column; align-items: stretch;
      padding: calc(var(--header-h) + var(--space-md)) var(--space-lg) var(--space-xl);
      overflow-y: auto;
      transform: translateY(100%);
      opacity: 0; visibility: hidden;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
                  opacity 0.35s ease, visibility 0.45s;
    }
    .nav-menu[data-open='true'] { transform: translateY(0); opacity: 1; visibility: visible; }

    /* Numbered list, vertically centred. */
    .nav-menu .nav-list {
      counter-reset: navnum;
      flex: 1; flex-direction: column; align-items: stretch; justify-content: center;
      gap: 0;
    }
    .nav-menu .nav-list li { border-top: 1px solid var(--color-line); }

    .nav-menu .nav-link {
      display: flex; align-items: baseline; gap: 1rem;
      padding: 1.05rem 0; border: none; color: var(--color-ink);
      font-family: var(--font-body); font-weight: 700; letter-spacing: -0.02em;
      font-size: clamp(1.9rem, 8vw, 2.6rem);
    }
    .nav-menu .nav-link::before {
      counter-increment: navnum;
      content: counter(navnum, decimal-leading-zero);
      color: var(--color-warm); font-weight: 600;
      font-size: 0.8rem; letter-spacing: 0.02em;
      align-self: flex-start; margin-top: 0.7rem; min-width: 1.4rem;
    }
    .nav-menu .nav-link.is-active { color: var(--color-warm); }
    .nav-menu .nav-link.is-active::after { display: none; }

    /* Donate as a full-width button under the list. */
    .nav-menu .nav-cta { border-top: 1px solid var(--color-line); padding-top: 1.25rem; }
    .nav-menu .nav-cta .btn {
      width: 100%; justify-content: center;
      background: var(--color-warm); color: #fff;
    }
    .nav-menu .nav-cta .btn:hover { background: var(--color-warm-hover); }

    /* Contact links pinned to the bottom. */
    .nav-contact {
      display: flex; flex-direction: column; gap: 0.55rem; margin-top: var(--space-lg);
    }
    .nav-contact a { text-decoration: none; font-size: var(--step-0); width: fit-content; }
    .nav-contact-email { color: var(--color-ink-soft); }
    .nav-contact-social { color: var(--color-warm); }
    .nav-contact a:hover { color: var(--color-ink); }

    /* When the menu is open, blend the header bar into the white menu. */
    .site-header.is-menu-open {
      background: transparent; backdrop-filter: none; box-shadow: none;
    }
    .site-header.is-menu-open .wordmark { color: var(--color-ink); }
    .site-header.is-menu-open .nav-toggle { border-color: var(--color-line); }
    .site-header.is-menu-open .nav-toggle-bars,
    .site-header.is-menu-open .nav-toggle-bars::before,
    .site-header.is-menu-open .nav-toggle-bars::after { background: var(--color-ink); }
  }
</style>

<script is:inline>
  const header = document.querySelector('.site-header');
  const toggle = document.querySelector('.nav-toggle');
  const menu = document.getElementById('primary-menu');

  // --- Full-screen mobile menu -------------------------------------------
  if (toggle && menu && header) {
    const setMenu = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.dataset.open = String(open);
      header.classList.toggle('is-menu-open', open);
      document.body.classList.toggle('menu-open', open); // locks scroll (global.css)
    };
    toggle.addEventListener('click', () => {
      setMenu(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setMenu(false);
    });
  }

  // --- Header turns solid just after the top -----------------------------
  if (header) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 20);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
