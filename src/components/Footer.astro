---
import { site, nav } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="wordmark">
        <span class="wordmark-mark" aria-hidden="true"></span>
        {site.name}
      </a>
      <p class="muted measure-narrow">{site.description}</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      <h2 class="footer-heading">Explore</h2>
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer-contact">
      <h2 class="footer-heading">Connect</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.social.instagram}>Instagram</a></li>
        <li><a href={site.social.linkedin}>LinkedIn</a></li>
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="muted">© {year} {site.name}. All rights reserved.</p>
    <p class="muted footer-legal">
      <!-- Replace with real links once you have these pages/documents. -->
      <a href="#">Privacy</a> · <a href="#">Terms</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface-warm);
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-xl) var(--space-lg);
    margin-top: var(--space-2xl);
  }
  .footer-inner {
    display: grid; gap: var(--space-lg);
    grid-template-columns: 1.5fr 1fr 1fr;
  }
  @media (max-width: 720px) {
    .footer-inner { grid-template-columns: 1fr; }
  }
  .footer-brand .wordmark {
    display: inline-flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-display); font-weight: 600;
    font-size: var(--step-1); text-decoration: none; margin-bottom: var(--space-sm);
  }
  .footer-brand .wordmark-mark {
    width: 20px; height: 20px; border-radius: 6px; background: var(--color-warm);
    box-shadow: inset 0 0 0 3px color-mix(in srgb, #fff 70%, transparent);
  }
  .footer-heading {
    font-family: var(--font-body); font-size: var(--step--1);
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--color-ink-soft); margin-bottom: var(--space-sm);
  }
  .footer-nav ul, .footer-contact ul { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .footer-nav a, .footer-contact a { text-decoration: none; color: var(--color-ink); }
  .footer-nav a:hover, .footer-contact a:hover { color: var(--color-accent); }

  .footer-bottom {
    display: flex; flex-wrap: wrap; gap: var(--space-sm);
    justify-content: space-between; align-items: center;
    margin-top: var(--space-xl); padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
    font-size: var(--step--1);
  }
  .footer-legal a { text-decoration: none; }
  .footer-legal a:hover { color: var(--color-accent); }
</style>
