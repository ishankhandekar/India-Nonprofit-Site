---
// Interactive, minimalist map of India.
// - Landmass is a single filled SVG path (generated in src/data/india-path.ts
//   from an official-boundaries dataset). Ocean = the section background.
// - Pins are positioned by real latitude/longitude, projected with the SAME
//   transform as the map, so they always land in the right place. To add a
//   location, add an entry below with its lat/lng — no pixel-guessing.
// - Layout: map on the left, info panel on the right (stacks on small screens).
//   The panel has a full-bleed image at the bottom and text up top; clicking a
//   pin fades in the location's name, description, and its own image.
import { indiaStates, indiaBorders, mapMeta } from '../data/india-path';

const project = (lng: number, lat: number): [number, number] => [
  (lng - mapMeta.minLng) * mapMeta.cosMid * mapMeta.scale,
  (mapMeta.maxLat - lat) * mapMeta.scale,
];

// Shared placeholder image (the hero photo) — give each location its own later.
const HERO_IMG = '/images/heropic.jpg';

// EXAMPLE locations — replace name / lat / lng / image / blurb with real ones.
// Keep blurbs to ~2 short sentences. `status` shows as a small badge.
const locations = [
  { name: 'New Delhi', lat: 28.61, lng: 77.21, status: 'Example', image: HERO_IMG, blurb: 'Placeholder location — swap in a real partner or project. In two short sentences, say who you work with here and what your team actually does.' },
  { name: 'Mumbai', lat: 19.07, lng: 72.88, status: 'Example', image: HERO_IMG, blurb: 'Placeholder location — swap in a real partner or project. In two short sentences, say who you work with here and what your team actually does.' },
  { name: 'Bengaluru', lat: 12.97, lng: 77.59, status: 'Example', image: HERO_IMG, blurb: 'Placeholder location — swap in a real partner or project. In two short sentences, say who you work with here and what your team actually does.' },
  { name: 'Kolkata', lat: 22.57, lng: 88.36, status: 'Example', image: HERO_IMG, blurb: 'Placeholder location — swap in a real partner or project. In two short sentences, say who you work with here and what your team actually does.' },
];

const pins = locations.map((l, i) => {
  const [x, y] = project(l.lng, l.lat);
  return { ...l, x: +x.toFixed(1), y: +y.toFixed(1), i };
});
---

<section class="section band map-section">
  <div class="container">
    <div class="map-head reveal">
      <span class="eyebrow">Where we work</span>
      <h2>On the ground in India.</h2>
      <p class="lead">Click a pin to see what we're doing there.</p>
    </div>

    <div class="map-layout reveal">
      <!-- LEFT: framed map + location chips -->
      <div class="map-side">
        <div class="map-frame">
          <svg
            class="india-map"
            viewBox={`0 0 ${mapMeta.W} ${mapMeta.H}`}
            role="group"
            aria-label="Map of India with selectable locations"
          >
            <g class="india-states">
              {indiaStates.map((s) => (
                <path d={s.d} class:list={['state', `c${s.ci}`]} />
              ))}
            </g>
            <path d={indiaBorders} class="state-borders" />
            {pins.map((p) => (
              <g
                class:list={['pin', { 'is-selected': p.i === 0 }]}
                data-index={p.i}
                data-name={p.name}
                data-blurb={p.blurb}
                data-status={p.status}
                data-image={p.image}
                aria-label={p.name}
              >
                <circle cx={p.x} cy={p.y} r="20" class="pin-hit" />
                <circle cx={p.x} cy={p.y} r="16" class="pin-ring" />
                <circle cx={p.x} cy={p.y} r="12" class="pin-dot" />
              </g>
            ))}
          </svg>
        </div>
        <div class="map-chips" role="group" aria-label="Jump to a location">
          {locations.map((l, i) => (
            <button class:list={['map-chip', { 'is-active': i === 0 }]} data-index={i}>
              <span class="map-chip-dot" aria-hidden="true"></span>{l.name}
            </button>
          ))}
        </div>
      </div>

      <!-- RIGHT: a photo card with the text over a gradient at the bottom.
           Defaults to the first location (this is also the no-JS state). -->
      <aside class="map-panel">
        <img class="map-panel-img" src={pins[0].image} alt="" />
        <div class="map-panel-scrim" aria-hidden="true"></div>
        <div class="map-panel-text" aria-live="polite">
          <span class="badge map-panel-badge">{pins[0].status}</span>
          <h3 class="map-panel-title">{pins[0].name}</h3>
          <p class="map-panel-blurb">{pins[0].blurb}</p>
        </div>
      </aside>
    </div>

    <!-- No-JS fallback: the same content as a plain list -->
    <ul class="map-list">
      {locations.map((l) => (
        <li><strong>{l.name}</strong> — <span class="muted">{l.blurb}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .map-head { text-align: center; max-width: 52ch; margin: 0 auto var(--space-md); }
  .map-head .lead { margin-top: var(--space-sm); }

  .map-layout {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-lg);
    align-items: stretch;          /* both columns share a height */
    margin-top: var(--space-md);
  }
  @media (max-width: 820px) {
    .map-layout { grid-template-columns: 1fr; gap: var(--space-lg); }
  }

  /* LEFT: framed map + location chips */
  .map-side { display: flex; flex-direction: column; gap: var(--space-md); }
  .map-frame {
    flex: 1;
    display: grid; place-items: center;
    padding: var(--space-md);
    border: 1px solid var(--color-line); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    background-color: var(--color-surface);
    /* faint dot grid so the "ocean" reads as a designed panel, not empty space */
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 16px 16px;
  }
  .india-map { width: 100%; max-width: 380px; height: auto; display: block; overflow: visible; }

  .map-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
  .map-chip {
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.42rem 0.85rem; border-radius: 999px; cursor: pointer;
    background: var(--color-surface); border: 1px solid var(--color-line);
    color: var(--color-ink-soft); font-weight: 500; font-size: var(--step--1);
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .map-chip:hover { border-color: var(--color-ink); color: var(--color-ink); }
  .map-chip-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-warm); }
  .map-chip.is-active { background: var(--color-warm); border-color: var(--color-warm); color: #fff; }
  .map-chip.is-active .map-chip-dot { background: #fff; }

  /* Pastel state fills (index from the data) + crisp border mesh on top. */
  .state.c0 { fill: #c3d7ef; }  /* soft blue */
  .state.c1 { fill: #f3cfb0; }  /* soft peach */
  .state.c2 { fill: #cbe2bd; }  /* soft green */
  .state.c3 { fill: #dccff0; }  /* soft violet */
  .state.c4 { fill: #bce0dc; }  /* soft teal */
  .state.c5 { fill: #eeddb8; }  /* soft sand */
  .state-borders {
    fill: none; stroke: rgba(20, 24, 31, 0.45); stroke-width: 1.2;
    stroke-linejoin: round; stroke-linecap: round;
  }

  /* Pins — shrink slightly on hover (transform about their own centre) */
  .pin {
    cursor: pointer;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.15s ease;
  }
  .pin:hover { transform: scale(0.85); }
  .pin-hit { fill: transparent; }               /* generous click/tap target */
  .pin-dot {
    fill: var(--color-warm); stroke: #fff; stroke-width: 2.5;
    paint-order: stroke;                 /* white halo so pins pop on any pastel */
    transition: fill 0.15s ease;
  }
  .pin-ring {
    fill: none; stroke: var(--color-ink); stroke-width: 3;
    opacity: 0; transition: opacity 0.15s ease;
  }
  .pin:hover .pin-dot { fill: var(--color-warm-hover); }
  .pin.is-selected .pin-ring { opacity: 1; }
  .pin:focus-visible { outline: none; }
  .pin:focus-visible .pin-ring { opacity: 1; stroke: var(--color-accent); }

  /* Panel — a single photo card with the text overlaid at the bottom. */
  .map-panel {
    position: relative;
    display: flex;
    min-height: 460px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;              /* clip the image to the rounded corners */
  }
  .map-panel-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: opacity 0.3s ease;
  }
  .map-panel-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top,
      rgba(20, 24, 31, 0.95) 0%,
      rgba(20, 24, 31, 0.80) 20%,
      rgba(20, 24, 31, 0.42) 42%,
      rgba(20, 24, 31, 0.10) 62%,
      transparent 80%);
  }
  .map-panel-text {
    position: relative; z-index: 1;
    margin-top: auto;              /* push the text to the bottom */
    padding: var(--space-lg);
    color: #fff;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.35);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .map-list { list-style: none; padding: 0; max-width: 620px; margin: var(--space-lg) auto 0; display: grid; gap: var(--space-sm); }
  .map-list li { padding-left: 1rem; border-left: 2px solid var(--color-warm); }
  /* When JS is available, the interactive panel replaces the static list. */
  :global(.js) .map-list { display: none; }
</style>

<script is:inline>
  (function () {
    const textEl = document.querySelector('.map-panel-text');
    const img = document.querySelector('.map-panel-img');
    const pins = document.querySelectorAll('.india-map .pin');
    const chips = Array.from(document.querySelectorAll('.map-chip'));
    if (!textEl || !img || !pins.length) return;

    function render(g) {
      const name = g.getAttribute('data-name');
      const blurb = g.getAttribute('data-blurb');
      const status = g.getAttribute('data-status');
      textEl.innerHTML =
        '<span class="badge map-panel-badge"></span>' +
        '<h3 class="map-panel-title"></h3>' +
        '<p class="map-panel-blurb"></p>';
      textEl.querySelector('.map-panel-title').textContent = name;
      textEl.querySelector('.map-panel-badge').textContent = status;
      textEl.querySelector('.map-panel-blurb').textContent = blurb;
    }

    function swapImage(src) {
      if (!src || img.getAttribute('src') === src) return;
      const next = new Image();
      next.onload = () => { img.src = src; img.style.opacity = '1'; };
      img.style.opacity = '0';
      next.src = src;
    }

    function select(g) {
      pins.forEach((p) => p.classList.toggle('is-selected', p === g));
      const idx = g.getAttribute('data-index');
      chips.forEach((c) => c.classList.toggle('is-active', c.getAttribute('data-index') === idx));
      swapImage(g.getAttribute('data-image'));
      // Fade the text out, swap content, fade back in.
      textEl.style.opacity = '0';
      textEl.style.transform = 'translateY(8px)';
      setTimeout(() => {
        render(g);
        textEl.style.opacity = '1';
        textEl.style.transform = 'none';
      }, 160);
    }

    pins.forEach((g) => {
      g.setAttribute('tabindex', '0');
      g.setAttribute('role', 'button');
      g.addEventListener('click', () => select(g));
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(g); }
      });
    });

    // Chips select the matching pin.
    chips.forEach((c) => {
      c.addEventListener('click', () => {
        const idx = c.getAttribute('data-index');
        const pin = Array.from(pins).find((p) => p.getAttribute('data-index') === idx);
        if (pin) select(pin);
      });
    });
  })();
</script>

<style is:global>
  /* Panel text internals (global so the JS-injected markup is styled).
     Scoped under .map-panel to outrank the base element/.badge rules. */
  .map-panel .map-panel-title {
    font-family: var(--font-display); font-size: var(--step-2);
    line-height: 1.15; color: #fff;
  }
  .map-panel .map-panel-badge {
    display: inline-flex; margin: 0 0 var(--space-sm);
    background: rgba(255, 255, 255, 0.18); color: #fff; border-color: transparent;
  }
  .map-panel .map-panel-badge::before { background: #fff; }
  .map-panel .map-panel-blurb {
    color: rgba(255, 255, 255, 0.88); line-height: 1.55;
    margin-top: var(--space-xs); max-width: 42ch;
  }
</style>
