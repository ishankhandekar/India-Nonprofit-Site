---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import IndiaMap from '../components/IndiaMap.astro';
import Timeline from '../components/Timeline.astro';

// Pull featured projects from the content collection, sorted by `order`.
const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Steps shown in the "How we work" timeline.
const steps = [
  { title: 'Partner with vetted groups', desc: 'We work alongside established organizations doing real work on the ground, rather than acting alone.' },
  { title: 'Mobilize students', desc: 'Our members contribute time, skills, and fundraising — gaining real experience while helping.' },
  { title: 'Stay transparent', desc: "We document what we actually do and where support goes, and we don't overstate our impact." },
];
---

<BaseLayout heroOverlay={true}>
  <!-- ================= HERO ================= -->
  <!-- Full-bleed photo + dark overlay + white text. Swap /images/heropic.jpg
       for the real professional photo later. -->
  <section class="hero">
    <div class="hero-bg" role="img" aria-label="Students collaborating on a project"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy reveal">
        <h1>Turning young people into a force for impact.</h1>
        <p class="hero-sub">
          We're a student-led nonprofit connecting young people in the U.S. with
          grassroots efforts in India — through fundraising, volunteering, and
          the skills we're building along the way.
        </p>
        <div class="hero-actions">
          <a href="/get-involved" class="btn hero-btn hero-btn--solid">Get involved</a>
          <a href="/our-work" class="btn hero-btn hero-btn--ghost">See our projects</a>
        </div>
        <!-- Honest stats only: founding year + a transparency commitment. Edit freely. -->
        <div class="hero-stats">
          <div class="hero-stat">
            <span class="hero-stat-num">2026</span>
            <span class="hero-stat-label">Founded this year</span>
          </div>
          <div class="hero-stat">
            <span class="hero-stat-num">100%</span>
            <span class="hero-stat-label">Funds tracked openly</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW WE WORK (process, not fake stats) ============ -->
  <section class="section band">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">How we work</span>
        <h2>A simple, honest model.</h2>
        <p class="lead measure">
          We're new, so instead of big numbers we'll show you exactly how we
          operate. This grows into a real impact summary as our work does.
        </p>
      </div>
      <div class="reveal">
        <Timeline steps={steps} />
      </div>
    </div>
  </section>

  <!-- ================= FEATURED WORK ================= -->
  <section class="section">
    <div class="container">
      <div class="section-head section-head--row reveal">
        <div>
          <span class="eyebrow">Our work</span>
          <h2>What we're working on now.</h2>
        </div>
        <a href="/our-work" class="btn btn--secondary">See all projects</a>
      </div>

      {projects.length > 0 ? (
        <div class="grid grid--2 reveal">
          {projects.map((p) => (
            <ProjectCard
              title={p.data.title}
              summary={p.data.summary}
              status={p.data.status}
              partner={p.data.partner || undefined}
              location={p.data.location}
            />
          ))}
        </div>
      ) : (
        <p class="muted">Projects will appear here as we launch them.</p>
      )}
    </div>
  </section>

  <!-- ================= WHERE WE WORK (interactive map) ================= -->
  <IndiaMap />

  <!-- ================= WHY TRUST US ================= -->
  <section class="section">
    <div class="container why-grid">
      <div class="section-head reveal">
        <span class="eyebrow">Why trust us</span>
        <h2>Credibility comes from being honest, not big.</h2>
      </div>
      <ul class="why-list reveal">
        <li><strong>We show real work.</strong> Every project here is something we're actually doing — clearly labeled with its current status.</li>
        <li><strong>Adults help oversee us.</strong> Students lead, with adult and eventual board oversight on money and partnerships.</li>
        <li><strong>No inflated claims.</strong> We never invent statistics, partnerships, or accomplishments.</li>
        <li><strong>Transparency by default.</strong> As we grow, our finances and outcomes will be documented openly.</li>
      </ul>
    </div>
  </section>

  <!-- ================= CTA BAND ================= -->
  <section class="section">
    <div class="container cta reveal">
      <h2>Want to help us get started?</h2>
      <p class="lead">Volunteer your time, partner with us, or spread the word.</p>
      <div class="hero-actions">
        <a href="/get-involved" class="btn btn--primary">Get involved</a>
        <a href="/about" class="btn btn--secondary">Learn about us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero: full-bleed photo, dark overlay, white text on top. --- */
  .hero {
    position: relative;
    min-height: 100svh;
    margin-top: calc(-1 * var(--header-h)); /* sit behind the transparent header */
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background: url('/images/heropic.jpg') center / cover no-repeat;
  }
  /* Darker on the left (behind the text), lighter on the right; plus a touch
     at the bottom so the stat row stays legible. */
  .hero-scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to right, rgba(18, 22, 28, 0.9) 0%, rgba(18, 22, 28, 0.6) 42%, rgba(18, 22, 28, 0.25) 100%),
      linear-gradient(to top, rgba(18, 22, 28, 0.55) 0%, transparent 45%);
  }
  .hero-inner { position: relative; z-index: 1; width: 100%; }
  .hero-copy { max-width: 42rem; color: #fff; }

  .hero h1 {
    font-family: var(--font-body);          /* bold sans, not the serif */
    font-weight: 800;
    font-size: clamp(2.25rem, 1.3rem + 3.2vw, 4rem);
    line-height: 1.05; letter-spacing: -0.025em;
    color: #fff;
  }
  .hero-sub {
    margin-top: var(--space-md);
    font-size: var(--step-1); line-height: 1.5;
    color: rgba(255, 255, 255, 0.82); max-width: 46ch;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-lg); }

  .hero-btn { padding: 0.9rem 1.6rem; }
  .hero-btn--solid { background: var(--color-warm); color: #fff; }
  .hero-btn--solid:hover { background: var(--color-warm-hover); }
  .hero-btn--ghost {
    background: rgba(255, 255, 255, 0.06); color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.45);
  }
  .hero-btn--ghost:hover { background: rgba(255, 255, 255, 0.14); border-color: #fff; }

  .hero-stats { display: flex; gap: clamp(2rem, 6vw, 4rem); margin-top: var(--space-xl); }
  .hero-stat-num {
    display: block; font-family: var(--font-body); font-weight: 800;
    font-size: var(--step-3); line-height: 1; color: var(--color-warm);
  }
  .hero-stat-label {
    display: block; margin-top: 0.35rem;
    font-size: var(--step--1); color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 820px) {
    /* Full viewport, content anchored to the bottom (keeps the buttons low),
       with a smaller headline/subhead so nothing overlaps the header. */
    .hero { min-height: 100svh; align-items: flex-end; }
    .hero-inner { padding-bottom: var(--space-xl); }
    .hero h1 { font-size: clamp(1.6rem, 7.5vw, 2.3rem); line-height: 1.1; }
    .hero-sub { font-size: var(--step-0); margin-top: var(--space-sm); }
    .hero-actions { margin-top: var(--space-md); }
    .hero-stats { gap: var(--space-xl); margin-top: var(--space-lg); }
  }

  /* --- Section headings --- */
  .section-head { margin-bottom: var(--space-xl); }
  .section-head .lead { margin-top: var(--space-sm); }
  .section-head--row {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: var(--space-md); flex-wrap: wrap;
  }

  /* --- Why --- */
  .why-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: var(--space-xl); align-items: start; }
  .why-grid .section-head { margin-bottom: 0; }
  .why-list { list-style: none; padding: 0; display: grid; gap: var(--space-md); }
  .why-list li { padding-left: 1.5rem; position: relative; }
  .why-list li::before {
    content: ""; position: absolute; left: 0; top: 0.6em;
    width: 8px; height: 8px; border-radius: 50%; background: var(--color-warm);
  }
  @media (max-width: 820px) { .why-grid { grid-template-columns: 1fr; gap: var(--space-lg); } }

  /* --- CTA --- */
  .cta {
    text-align: center; background: var(--color-ink); color: #fff;
    border-radius: var(--radius-lg); padding: var(--space-2xl) var(--space-lg);
  }
  .cta h2 { color: #fff; }
  .cta .lead { color: color-mix(in srgb, #fff 78%, transparent); margin: var(--space-sm) auto var(--space-md); }
  .cta .hero-actions { justify-content: center; }
  .cta .btn--secondary { color: #fff; border-color: color-mix(in srgb, #fff 30%, transparent); }
  .cta .btn--secondary:hover { background: color-mix(in srgb, #fff 10%, transparent); border-color: #fff; }
</style>
