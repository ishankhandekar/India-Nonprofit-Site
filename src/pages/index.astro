---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import IndiaMap from '../components/IndiaMap.astro';
import Timeline from '../components/Timeline.astro';

// Pull featured projects from the content collection, sorted by `order`.
const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Steps shown in the "How we work" timeline.
const steps = [
  { title: 'Partner with vetted groups', desc: 'We work alongside established organizations doing real work on the ground, rather than acting alone.' },
  { title: 'Mobilize students', desc: 'Our members contribute time, skills, and fundraising — gaining real experience while helping.' },
  { title: 'Stay transparent', desc: "We document what we actually do and where support goes, and we don't overstate our impact." },
];
---

<BaseLayout heroOverlay={true}>
  <!-- ================= HERO ================= -->
  <!-- Full-bleed photo + dark overlay + white text. Swap /images/heropic.jpg
       for the real professional photo later. -->
  <section class="hero">
    <div class="hero-bg" role="img" aria-label="Students collaborating on a project"></div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-copy reveal">
        <span class="hero-badge">
          <span class="hero-badge-dot" aria-hidden="true"></span>
          Student-led · Founded 2026
        </span>
        <h1>Turning young people into a <em class="hero-em">force for impact.</em></h1>
        <p class="hero-sub">
          We're a student-led nonprofit connecting young people in the U.S. with
          grassroots efforts in India — through fundraising, volunteering, and
          the skills we're building along the way.
        </p>
        <div class="hero-actions">
          <a href="/get-involved" class="btn hero-btn hero-btn--solid">
            Get involved <span class="hero-btn-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="/our-work" class="btn hero-btn hero-btn--ghost">See our projects</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS STRIP ============ -->
  <!-- Placeholder metrics. Numbers are intentionally dashes until we have
       real, verifiable figures — never invent stats. Fill each `stat-num`
       when the number is true. -->
  <section class="section--tight stats-section">
    <div class="container">
      <div class="stats-grid reveal">
        <div class="stat-card">
          <span class="stat-num">—</span>
          <span class="stat-label">Children reached</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">—</span>
          <span class="stat-label">Student volunteers</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">—</span>
          <span class="stat-label">Villages supported</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">—</span>
          <span class="stat-label">Raised since founding</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW WE WORK (process, not fake stats) ============ -->
  <section class="section band">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">How we work</span>
        <h2>A simple, honest model.</h2>
        <p class="lead measure">
          We're new, so instead of big numbers we'll show you exactly how we
          operate. This grows into a real impact summary as our work does.
        </p>
      </div>
      <div class="reveal">
        <Timeline steps={steps} />
      </div>
    </div>
  </section>

  <!-- ================= WHAT WE FUND ================= -->
  <section class="section">
    <div class="container">
      <div class="fund-head reveal">
        <div>
          <span class="eyebrow">What we fund</span>
          <h2>Three programs, <em class="fund-em">one mission.</em></h2>
        </div>
        <p class="fund-lead">
          Support raised through our student chapters is directed toward focused,
          on-the-ground programs like these.
        </p>
      </div>

      {projects.length > 0 ? (
        <div class="grid grid--3 reveal">
          {projects.map((p, i) => (
            <ProjectCard
              title={p.data.title}
              summary={p.data.summary}
              status={p.data.status}
              category={p.data.category}
              image={p.data.image || undefined}
              index={i + 1}
            />
          ))}
        </div>
      ) : (
        <p class="muted">Programs will appear here as we launch them.</p>
      )}
    </div>
  </section>

  <!-- ================= WHERE WE WORK (interactive map) ================= -->
  <IndiaMap />

  <!-- ================= WHY TRUST US ================= -->
  <section class="section">
    <div class="container why-grid">
      <div class="section-head reveal">
        <span class="eyebrow">Why trust us</span>
        <h2>Credibility comes from being honest, not big.</h2>
      </div>
      <ul class="why-list reveal">
        <li><strong>We show real work.</strong> Every project here is something we're actually doing — clearly labeled with its current status.</li>
        <li><strong>Adults help oversee us.</strong> Students lead, with adult and eventual board oversight on money and partnerships.</li>
        <li><strong>No inflated claims.</strong> We never invent statistics, partnerships, or accomplishments.</li>
        <li><strong>Transparency by default.</strong> As we grow, our finances and outcomes will be documented openly.</li>
      </ul>
    </div>
  </section>

  <!-- ================= CTA BAND ================= -->
  <section class="section">
    <div class="container cta reveal">
      <h2>Want to help us get started?</h2>
      <p class="lead">Volunteer your time, partner with us, or spread the word.</p>
      <div class="hero-actions">
        <a href="/get-involved" class="btn btn--primary">Get involved</a>
        <a href="/about" class="btn btn--secondary">Learn about us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* --- Hero: full-bleed photo, dark overlay, white text on top. --- */
  .hero {
    position: relative;
    min-height: 100svh;
    margin-top: calc(-1 * var(--header-h)); /* sit behind the transparent header */
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background: url('/images/heropic.jpg') center / cover no-repeat;
  }
  /* Darker on the left (behind the text), lighter on the right; plus a touch
     at the bottom so the stat row stays legible. */
  .hero-scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to right, rgba(18, 22, 28, 0.9) 0%, rgba(18, 22, 28, 0.6) 42%, rgba(18, 22, 28, 0.25) 100%),
      linear-gradient(to top, rgba(18, 22, 28, 0.55) 0%, transparent 45%);
  }
  .hero-inner { position: relative; z-index: 1; width: 100%; }
  .hero-copy { max-width: 42rem; color: #fff; }

  /* Small pill above the headline — subtle, gives the hero room to breathe. */
  .hero-badge {
    display: inline-flex; align-items: center; gap: 0.5rem;
    margin-bottom: var(--space-lg);
    padding: 0.4rem 0.85rem;
    font-size: var(--step--1); font-weight: 500; letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.92);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }
  .hero-badge-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--color-warm);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-warm) 35%, transparent);
  }

  .hero h1 {
    font-family: var(--font-display);       /* warm high-contrast serif */
    font-weight: 680;
    font-size: clamp(2.5rem, 1.4rem + 3.7vw, 4.6rem);
    line-height: 1.04; letter-spacing: -0.015em;
    color: #fff;
  }
  .hero h1 .hero-em {
    font-style: italic;
    font-weight: 600;
    color: var(--color-warm);
  }
  .hero-sub {
    margin-top: var(--space-md);
    font-size: var(--step-1); line-height: 1.5;
    color: rgba(255, 255, 255, 0.82); max-width: 46ch;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-lg); }

  .hero-btn { padding: 0.9rem 1.6rem; }
  /* Diagonal arrow — nudges up-right on hover, matching the nav Donate button. */
  .hero-btn-arrow { display: inline-block; transition: transform 0.18s ease; }
  .hero-btn--solid:hover .hero-btn-arrow { transform: translate(2px, -2px); }
  .hero-btn--solid { background: var(--color-warm); color: #fff; }
  .hero-btn--solid:hover { background: var(--color-warm-hover); }
  .hero-btn--ghost {
    background: rgba(255, 255, 255, 0.06); color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.45);
  }
  .hero-btn--ghost:hover { background: rgba(255, 255, 255, 0.14); border-color: #fff; }

  @media (max-width: 820px) {
    /* Full viewport, content anchored to the bottom (keeps the buttons low),
       with a smaller headline/subhead so nothing overlaps the header. */
    .hero { min-height: 100svh; align-items: flex-end; }
    .hero-inner { padding-bottom: var(--space-xl); }
    .hero h1 { font-size: clamp(1.6rem, 7.5vw, 2.3rem); line-height: 1.1; }
    .hero-sub { font-size: var(--step-0); margin-top: var(--space-sm); }
    .hero-actions { margin-top: var(--space-md); }
    .hero-badge { margin-bottom: var(--space-md); }
  }

  /* --- Stats strip (bordered cards, placeholder dashes) --- */
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-md); }
  .stat-card {
    padding: var(--space-lg) var(--space-md);
    border: 1px solid var(--color-line); border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }
  .stat-num {
    display: block; font-family: var(--font-display); font-weight: 600;
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem); line-height: 1;
    color: var(--color-ink); letter-spacing: -0.02em;
  }
  .stat-label {
    display: block; margin-top: 0.55rem;
    font-size: var(--step--1); color: var(--color-ink-soft);
  }
  @media (max-width: 820px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-sm); }
  }

  /* --- "What we fund" head: title left, lead right (like the reference) --- */
  .fund-head {
    display: grid; grid-template-columns: 1.1fr 0.9fr;
    align-items: end; gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }
  .fund-head h2 {
    margin-top: 0.4rem;
    font-size: clamp(1.9rem, 1.4rem + 2vw, 2.9rem);
    font-weight: 620; line-height: 1.05;
  }
  .fund-em { font-style: italic; font-weight: 600; color: var(--color-warm); }
  .fund-lead {
    font-size: var(--step-1); line-height: 1.5;
    color: var(--color-ink-soft); max-width: 40ch; justify-self: end;
  }
  @media (max-width: 820px) {
    .fund-head { grid-template-columns: 1fr; align-items: start; gap: var(--space-sm); }
    .fund-lead { justify-self: start; }
  }

  /* --- Section headings --- */
  .section-head { margin-bottom: var(--space-xl); }
  .section-head .lead { margin-top: var(--space-sm); }
  .section-head--row {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: var(--space-md); flex-wrap: wrap;
  }

  /* --- Why --- */
  .why-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: var(--space-xl); align-items: start; }
  .why-grid .section-head { margin-bottom: 0; }
  .why-list { list-style: none; padding: 0; display: grid; gap: var(--space-md); }
  .why-list li { padding-left: 1.5rem; position: relative; }
  .why-list li::before {
    content: ""; position: absolute; left: 0; top: 0.6em;
    width: 8px; height: 8px; border-radius: 50%; background: var(--color-warm);
  }
  @media (max-width: 820px) { .why-grid { grid-template-columns: 1fr; gap: var(--space-lg); } }

  /* --- CTA --- */
  .cta {
    text-align: center;
    background: var(--color-surface); border: 1px solid var(--color-line);
    border-radius: var(--radius-lg); padding: var(--space-2xl) var(--space-lg);
  }
  .cta .lead { margin: var(--space-sm) auto var(--space-md); }
  .cta .hero-actions { justify-content: center; }
</style>
