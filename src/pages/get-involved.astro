---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Get Involved" description="Volunteer, partner, or support our work.">
  <section class="section--tight page-header">
    <div class="container stack reveal">
      <span class="eyebrow">Get involved</span>
      <h1>There's a place for you here.</h1>
      <p class="lead measure">
        Whether you have time, connections, or resources, here's how you can be
        part of what we're building.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--3 reveal">
        <!-- VOLUNTEER -->
        <div class="involve">
          <div class="involve-icon involve-icon--cobalt" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          </div>
          <h3>Volunteer</h3>
          <p class="muted">Join a team — tech, fundraising, marketing, social, or partnerships — and contribute your skills.</p>
          <!-- Replace '#' with a Google Form / Tally link. No custom backend needed. -->
          <a href="#" class="involve-link">Apply to volunteer <span class="arrow" aria-hidden="true">→</span></a>
        </div>

        <!-- PARTNER -->
        <div class="involve">
          <div class="involve-icon involve-icon--warm" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
            </svg>
          </div>
          <h3>Partner with us</h3>
          <p class="muted">Are you an organization doing work we could support? We'd love to talk.</p>
          <a href="#" class="involve-link">Start a conversation <span class="arrow" aria-hidden="true">→</span></a>
        </div>

        <!-- DONATE (intentionally not live yet) -->
        <div class="involve">
          <div class="involve-icon involve-icon--neutral" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z" />
            </svg>
          </div>
          <h3>Donate</h3>
          <p class="muted">Online donations aren't open yet. We're setting this up properly, with oversight, before accepting any funds.</p>
          <span class="involve-soon">Coming soon</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact fallback -->
  <section class="section--tight">
    <div class="container">
      <div class="contact-band reveal">
        <div>
          <h2>Not sure where you fit?</h2>
          <p class="muted">Reach out and we'll help you find a place.</p>
        </div>
        <a href="/#" class="btn btn--secondary">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { padding-top: var(--space-xl); }

  .involve {
    display: flex; flex-direction: column; gap: var(--space-sm);
    height: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .involve:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: color-mix(in srgb, var(--color-ink) 14%, var(--color-line));
  }

  .involve-icon {
    width: 52px; height: 52px; border-radius: 14px;
    display: grid; place-items: center; margin-bottom: var(--space-xs);
  }
  .involve-icon svg { width: 26px; height: 26px; }
  .involve-icon--cobalt { background: var(--color-accent-soft); color: var(--color-accent); }
  .involve-icon--warm { background: var(--color-warm-soft); color: var(--color-warm); }
  .involve-icon--neutral { background: var(--color-surface-warm); color: var(--color-ink-soft); }

  .involve h3 { margin-top: 0.15rem; }

  /* Arrow-link CTA, pinned to the card bottom so all three align. */
  .involve-link {
    margin-top: auto; padding-top: var(--space-xs);
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-weight: 600; color: var(--color-accent); text-decoration: none;
  }
  .involve-link .arrow { transition: transform 0.18s ease; }
  .involve:hover .involve-link .arrow { transform: translateX(4px); }
  .involve-link:hover { text-decoration: underline; text-underline-offset: 4px; }

  .involve-soon {
    margin-top: auto; padding-top: var(--space-xs);
    font-weight: 600; color: var(--color-ink-soft);
  }

  .contact-band {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-md); flex-wrap: wrap;
    border: 1px solid var(--color-line); border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-xl); background: var(--color-surface);
  }
</style>
